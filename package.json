{
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "docs",
    "storybook"
  ],
  "resolutions": {
    "startupjs": "portal:../startupjs/core/startupjs",
    "babel-preset-startupjs": "portal:../startupjs/core/babel-preset-startupjs",
    "@startupjs/auth": "portal:../startupjs/core/auth",
    "@startupjs/babel-plugin-eliminator": "portal:../startupjs/core/babel-plugin-eliminator",
    "@startupjs/babel-plugin-i18n-extract": "portal:../startupjs/core/babel-plugin-i18n-extract",
    "@startupjs/babel-plugin-startupjs": "portal:../startupjs/core/babel-plugin-startupjs",
    "@startupjs/babel-plugin-startupjs-debug": "portal:../startupjs/core/babel-plugin-startupjs-debug",
    "@startupjs/babel-plugin-startupjs-plugins": "portal:../startupjs/core/babel-plugin-startupjs-plugins",
    "@startupjs/babel-plugin-ts-to-json-schema": "portal:../startupjs/core/babel-plugin-ts-to-json-schema",
    "@startupjs/bundler": "portal:../startupjs/core/bundler",
    "@startupjs/cli": "portal:../startupjs/core/cli",
    "@startupjs/hooks": "portal:../startupjs/core/hooks",
    "@startupjs/isomorphic-helpers": "portal:../startupjs/core/isomorphic-helpers",
    "@startupjs/registry": "portal:../startupjs/core/registry",
    "@startupjs/server": "portal:../startupjs/core/server",
    "@startupjs/skills": "portal:../startupjs/core/skills",
    "@startupjs/utils": "portal:../startupjs/core/utils",
    "cssxjs": "portal:../cssx/packages/cssxjs",
    "babel-preset-cssxjs": "portal:../cssx/packages/babel-preset-cssxjs",
    "@cssxjs/babel-plugin-rn-stylename-inline": "portal:../cssx/packages/babel-plugin-rn-stylename-inline",
    "@cssxjs/babel-plugin-rn-stylename-to-style": "portal:../cssx/packages/babel-plugin-rn-stylename-to-style",
    "@cssxjs/bundler": "portal:../cssx/packages/bundler",
    "@cssxjs/css-to-rn": "portal:../cssx/packages/css-to-rn",
    "@cssxjs/loaders": "portal:../cssx/packages/loaders"
  },
  "scripts": {
    "start": "yarn docs",
    "build": "cd docs && yarn build",
    "build-static": "cd docs && yarn build-static",
    "postinstall": "npx startupjs postinstall",
    "start-production": "cd docs && yarn start-production",
    "start-production-static": "cd docs && yarn start-production-static",
    "docs": "cd docs && yarn start",
    "storybook": "yarn workspace startupjs-ui-storybook storybook",
    "storybook:web": "yarn workspace startupjs-ui-storybook storybook",
    "storybook:build": "yarn workspace startupjs-ui-storybook build-storybook",
    "storybook:build:pages": "yarn workspace startupjs-ui-storybook build-storybook --output-dir ../docs/dist/storybook",
    "storybook:test": "yarn workspace startupjs-ui-storybook test-storybook",
    "storybook:test:watch": "yarn workspace startupjs-ui-storybook test-storybook:watch",
    "storybook:native": "yarn workspace startupjs-ui-storybook start",
    "storybook:native:web": "yarn workspace startupjs-ui-storybook web",
    "storybook:native:build": "yarn workspace startupjs-ui-storybook build",
    "test": "sh -c 'set -e; for dir in packages/*/; do echo \"Testing $dir\"; (cd \"$dir\" && yarn test) || { echo \"\\033[31mERROR: Tests failed for $dir\\033[0m\"; exit 1; }; done'",
    "docs:style-reference": "node scripts/update-style-reference-docs.mjs",
    "generate-package-dts": "node scripts/generate-package-dts.mjs",
    "publish-patch": "dotenv -- npx lerna publish patch --conventional-commits --create-release=github",
    "publish-patch-force": "dotenv -- npx lerna publish patch --force-publish --conventional-commits --create-release=github",
    "publish-breaking-minor": "dotenv -- npx lerna publish minor --conventional-commits --create-release=github",
    "publish-alpha-patch": "dotenv -- npx lerna publish prerelease --preid alpha --dist-tag alpha --conventional-commits --create-release=github",
    "publish-alpha-breaking-minor": "dotenv -- npx lerna publish preminor --preid alpha --dist-tag alpha --force-publish --conventional-commits --create-release=github"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.21",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-cssxjs": "^0.3.0",
    "husky": "^4.3.0",
    "lerna": "^9.0.3",
    "lint-staged": "^15.2.2",
    "neostandard": "^0.13.0",
    "playwright": "^1.58.2",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn generate-package-dts && node scripts/check-startupjs-ui-exports.mjs && (! grep -q '\"resolutions\":' ./package.json || (echo '\\033[0;31mError: \"resolutions\" found in package.json. Remove \"resolutions\" to proceed with commit.\\033[0m' && exit 1)) && lint-staged"
    }
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}

{
  "name": "docs",
  "main": "expo-router/entry",
  "version": "0.4.0-alpha.5",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build": "npx startupjs build",
    "build-static": "yarn switch-to-static && npx startupjs build && yarn switch-to-single || yarn switch-to-single",
    "switch-to-static": "node -e \"require('fs').writeFileSync('./app.json', JSON.stringify((json = require('./app.json'), json.expo.web.output = 'static', json), null, 2) + '\\n')\"",
    "switch-to-single": "node -e \"require('fs').writeFileSync('./app.json', JSON.stringify((json = require('./app.json'), json.expo.web.output = 'single', json), null, 2) + '\\n')\"",
    "start-production": "npx startupjs start-production",
    "start-production-static": "serve ./dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.967.0",
    "@azure/storage-blob": "^12.31.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@startupjs-ui/docs": "^0.4.0-alpha.5",
    "@startupjs-ui/mdx": "^0.4.0-alpha.5",
    "@startupjs/router": "^0.64.0-alpha.11",
    "expo": "~55.0.11",
    "expo-clipboard": "~55.0.11",
    "expo-constants": "~55.0.11",
    "expo-document-picker": "~55.0.11",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.11",
    "expo-image": "~55.0.8",
    "expo-image-picker": "~55.0.16",
    "expo-linking": "~55.0.11",
    "expo-router": "~55.0.10",
    "expo-splash-screen": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.13",
    "expo-web-browser": "~55.0.12",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-pager-view": "8.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "startupjs": "^0.64.0-alpha.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint-config-expo": "~55.0.0",
    "husky": "^4.3.0",
    "lint-staged": "^15.2.2",
    "serve": "^14.2.5",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8",
  "type": "module"
}

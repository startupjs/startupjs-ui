$gutter = $UI.gutters.m

.root
  padding $gutter

  &.between
    justify-content space-between

  &.right
    justify-content flex-end

.title
  font(h5)
  flex 1

.titleHost
  flex 1
  min-width 0

.close
  margin-left 2u

.icon
  color: var(--color-text-description)

.srOnly
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0
